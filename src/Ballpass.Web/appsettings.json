{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicBaseUrl": "",
  // Demo: persona switch pill + /demo/reset (needs a signed-in persona, 1 per minute). Off by default; true in appsettings.Development.json.
  // Featured: the coach / athlete / need the 60-second demo path starts from (home doors, /demo featured cards, /match prefill).
  // Empty here; the values live in appsettings.Development.json (or env Demo__Featured__*).
  "Demo": {
    "Enabled": false,
    "Featured": { "CoachFirstName": "", "CoachLastName": "", "AthleteSlug": "", "NeedQuery": "" }
  },
  // Messages: IANA time zone for message times and the "Σήμερα / Χθες" day separators.
  "Messages": { "TimeZone": "Europe/Athens" },
  // Evidence: peers (and the athlete) under this many minutes per game get no percentile. Our estimate, not a league rule.
  "Evidence": { "MinMinutesPerGame": 15, "MinPeers": 15 },
  "Feed": {
    "BoostLookingForTeamHours": 12,
    "BoostTryoutHours": 12,
    "BoostCoachConfirmedHours": 6,
    "ReportHideThreshold": 3,
    "PostCooldownSeconds": 60
  },
  // Fit: DEFAULT weights, hand-chosen estimates (not learned, not measured). They renormalise over the criteria a coach requests.
  "Fit": {
    "Weights": { "Height": 0.30, "Stat": 0.30, "Region": 0.15, "Age": 0.15, "League": 0.10 },
    "MinGames": 10,
    "HeightFalloffCm": 10,
    "AgeFalloffYears": 4
  },
  // Ai: natural-language search. Enabled omitted = on only when a key exists; false = kill switch (live reload).
  // The key is NEVER here: user-secrets "Anthropic:ApiKey" (see README: read -s, set does not prompt) or env Anthropic__ApiKey.
  "Ai": {
    "Model": "claude-opus-5-5",
    "TimeoutSeconds": 10,
    "MaxCallsPerSession": 20
  }
}
