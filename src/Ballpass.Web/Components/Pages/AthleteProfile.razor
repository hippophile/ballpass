@page "/p/{Slug}"
@using System.Globalization
@using Ballpass.Web.Components.Shared
@using Ballpass.Web.Data
@using Ballpass.Web.Demo
@using Ballpass.Web.Features.Evidence
@using Ballpass.Web.Features.Loop
@using Ballpass.Web.Features.Media
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject BallpassDbContext Db
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject ICohortService Cohorts
@inject IOptions<DemoOptions> Demo
@inject IStringLocalizer<SharedResource> L
@inject IStringLocalizer<LoopResource> Loop
@inject IStringLocalizer<EvidenceResource> Evid
@inject IStringLocalizer<FindResource> F

@if (athlete is not null)
{
    <PageTitle>@FullName — @PositionLong</PageTitle>
    <HeadContent>
        <meta property="og:title" content="@($"{FullName} — {PositionLong}, {athlete.HeightCm} cm")" />
        <meta property="og:description" content="@OgDescription" />
        <meta property="og:type" content="profile" />
        <meta property="og:url" content="@ShareUrl" />
        <ShareMeta Athlete="athlete" />
    </HeadContent>

    @* flow-release §4.4: cover + identity, then main column (proof row, highlights, evidence + table, history/bio) and the action
       rail (sticky; a bottom bar under 640 px). One .bp-btn-primary for a coach: "Εκδήλωση ενδιαφέροντος". *@
    <div class="bp-profile@(coachId is not null ? " bp-profile-coach" : "")">
    <header class="bp-cover">
        <StockPhoto Image="StockMedia.Cover(Slug)" Priority="true" Left="true" Class="bp-cover-photo" />
        <div class="bp-cover-id">
            <JerseyAvatar Id="athlete.Id" Initials="@Initials" Club="@athlete.CurrentClub?.Name" Size="120" Class="bp-profile-jersey bp-cover-jersey" />
            <div class="bp-cover-text">
                <h1>@FullName</h1>
                @if (athlete.LookingForTeam)
                {
                    <p class="bp-cover-chips"><span class="bp-chip-athlete">@L["Badge_LookingForTeam"]</span></p>
                }
                <p class="bp-cover-meta">@PositionLong (@athlete.Position) · @athlete.HeightCm @L["Profile_Cm"] · @Age @L["Profile_Years"] · @CityName, @RegionName · <strong>@(DisplayText.Club(athlete.CurrentClub) ?? L["Profile_NoClub"].Value)</strong></p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <p class="bp-status" role="status">@StatusMessage</p>
    }

    <div class="bp-profile-body">
        <div class="bp-profile-main">
            <section class="bp-proof" aria-label="@L["Profile_Stats"]">
                @if (stats.Count == 0)
                {
                    <p class="bp-proof-empty">@L["Profile_NoStats"]</p>
                }
                else
                {
                    <div class="bp-proof-stat"><span class="bp-proof-num">@Num(stats[0].Points)</span><span class="bp-proof-label">@F["Card_Ppg"]</span></div>
                    <div class="bp-proof-stat"><span class="bp-proof-num">@Num(stats[0].Rebounds)</span><span class="bp-proof-label">@F["Card_Rpg"]</span></div>
                    <div class="bp-proof-stat"><span class="bp-proof-num">@Num(stats[0].Assists)</span><span class="bp-proof-label">@F["Card_Apg"]</span></div>
                    <div class="bp-proof-side">
                        <p class="bp-proof-season">@F["Proof_Season", stats[0].Season, L[$"League_{stats[0].League}"].Value] <span class="bp-proof-src @SourceClass(stats[0].Source)">@L[$"Source_{stats[0].Source}"]</span></p>
                        @if (bestPercentiles.Count > 0)
                        {
                            <p class="bp-proof-pills">
                                @foreach (var m in bestPercentiles)
                                {
                                    <span class="bp-proof-pill" data-pct="@m.Percentile">@F["Proof_Pct", Evid[$"Metric_{m.Metric}"].Value, Ordinal.Format(m.Percentile!.Value)]</span>
                                }
                            </p>
                        }
                    </div>
                }
            </section>

            <ProfileHighlights AthleteId="athlete.Id" Slug="@Slug">
            <section class="bp-card bp-panel bp-novideo">
                <h2>@L["Profile_Video"]</h2>
                <p class="video-empty">@L["Profile_NoVideo"]</p>
            </section>
            </ProfileHighlights>

            @if (stats.Count > 0)
            {
                <section class="bp-card bp-panel bp-profile-stats">
                    <h2>@L["Profile_Stats"]</h2>
                    <EvidencePanel Athlete="athlete" />
                    <div class="table-scroll">
                        <table class="stats">
                            <thead>
                                <tr>
                                    <th scope="col">@L["Stat_Season"]</th>
                                    <th scope="col">@L["Stat_League"]</th>
                                    <th scope="col">@L["Stat_Games"]</th>
                                    <th scope="col">@L["Stat_Minutes"]</th>
                                    <th scope="col">@L["Stat_Points"]</th>
                                    <th scope="col">@L["Stat_Rebounds"]</th>
                                    <th scope="col">@L["Stat_Assists"]</th>
                                    <th scope="col">@L["Stat_Steals"]</th>
                                    <th scope="col">@L["Stat_Blocks"]</th>
                                    <th scope="col">@L["Stat_FgPct"]</th>
                                    <th scope="col">@L["Stat_ThreePct"]</th>
                                    <th scope="col">@L["Stat_FtPct"]</th>
                                    <th scope="col">@L["Stat_Source"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in stats)
                                {
                                    <tr data-season="@s.Season">
                                        <th scope="row">@s.Season</th>
                                        <td>@L[$"League_{s.League}"]</td>
                                        <td>@s.Games</td>
                                        <td>@Num(s.Minutes)</td>
                                        <td>@Num(s.Points)</td>
                                        <td>@Num(s.Rebounds)</td>
                                        <td>@Num(s.Assists)</td>
                                        <td>@Num(s.Steals)</td>
                                        <td>@Num(s.Blocks)</td>
                                        <td>@Num(s.FgPct)</td>
                                        <td>@Num(s.ThreePct)</td>
                                        <td>@Num(s.FtPct)</td>
                                        <td><SourceBadge Source="s.Source" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            <section class="bp-card bp-panel bp-profile-about@(string.IsNullOrWhiteSpace(athlete.Bio) ? "" : " bp-profile-about-2")">
                <div>
                    <h2>@L["Profile_ClubHistory"]</h2>
                    <ul class="history">
                        @foreach (var s in history)
                        {
                            <li><span class="history-season">@s.Season</span> <span>@DisplayText.Club(s.Club)</span></li>
                        }
                    </ul>
                </div>
                @if (!string.IsNullOrWhiteSpace(athlete.Bio))
                {
                    <div>
                        <h2>@L["Profile_Bio"]</h2>
                        <p class="bp-profile-bio">@DisplayText.Pick(athlete.Bio, athlete.BioEn)</p>
                    </div>
                }
            </section>
        </div>

        <aside class="bp-action-rail" id="bp-actions" aria-label="@L["Interest_Heading"]">
            @if (coachId is not null)
            {
                @if (interest is not null)
                {
                    <div class="bp-rail-sent" data-rail="sent">
                        <p class="bp-rail-sent-title">@F["Rail_SentTitle", DisplayDate.Date(interest.CreatedAt.ToLocalTime().DateTime)]</p>
                        <ol class="bp-stepper bp-rail-steps">
                            <li class="bp-step-coach bp-step-done">@F["Rail_StepSent"]</li>
                            <li class="bp-step-coach@(interest.SeenAt is null ? "" : " bp-step-done")">@F["Rail_StepSeen"]</li>
                            <li class="bp-step-athlete@(interest.Reply == InterestReply.None ? "" : " bp-step-done")">@F["Rail_StepReply"]</li>
                        </ol>
                        @if (showSwitch)
                        {
                            <form method="post" action="/demo/switch?to=athlete" data-demo-switch="athlete" class="bp-rail-switch-form">
                                <AntiforgeryToken />
                                <button type="submit" class="bp-rail-switch">@F[athlete.Gender == Gender.Male ? "Rail_SeeAs_M" : "Rail_SeeAs_F", FirstName]</button>
                            </form>
                        }
                        @if (interest.Reply == InterestReply.Accepted) { <MessageButton InterestId="interest.Id" Class="bp-btn-primary" /> }
                        <a class="bp-rail-all" href="/me/sent">@F["Rail_AllSent"]</a>
                    </div>
                }
                <div class="bp-loop-actionbar">
                    @if (interest is null)
                    {
                        <form method="post" action="/p/@Slug/interest" data-action="interest" class="bp-loop-interest bp-rail-interest">
                            <AntiforgeryToken />
                            <button type="submit" class="bp-btn-primary">@L["Interest_Submit"]</button>
                            <details class="bp-loop-note">
                                <summary>@Loop["Actions_NoteToggle"]</summary>
                                <label for="interest-note">@L["Interest_NoteLabel"]</label>
                                <textarea id="interest-note" name="note" maxlength="280" rows="3"></textarea>
                            </details>
                        </form>
                    }
                    @* Desktop: always open (::details-content); bottom bar under 640 px: the "⋯" sheet. *@
                    <details class="bp-rail-more">
                        <summary class="bp-btn-ghost" aria-label="@F["Rail_More"]"><span aria-hidden="true">⋯</span></summary>
                        <div class="bp-rail-ghosts">
                            <form method="post" action="/p/@Slug/shortlist" data-action="shortlist" class="bp-loop-inline">
                                <AntiforgeryToken />
                                <button type="submit" class="bp-btn bp-btn-secondary" aria-pressed="@(shortlisted ? "true" : "false")" aria-label="@L[shortlisted ? "Shortlist_Remove" : "Shortlist_Add"]">@Loop["Actions_List"]</button>
                            </form>
                            <FollowButton Slug="@Slug" />
                            <a class="bp-btn bp-btn-secondary" href="/compare?a=@Slug">@Evid["Compare_Link"]</a>
                        </div>
                        @ShareDetails
                    </details>
                </div>
            }
            else
            {
                @if (isOwnProfile)
                {
                    <p class="bp-received"><a href="/me/inbox">@F["Rail_Received", receivedCount]</a></p>
                }
                <FollowButton Slug="@Slug" />
                @ShareDetails
            }
        </aside>
    </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private const int ProofMinPercentile = 50;
    private Athlete? athlete;
    private List<StatLine> stats = [];
    private List<AthleteSeason> history = [];
    private List<MetricPercentile> bestPercentiles = [];
    private int? coachId;
    private Interest? interest;
    private bool showSwitch;
    private bool shortlisted;
    private bool isOwnProfile;
    private int receivedCount;

    // interest-sent / interest-exists: the rail swaps to the sent card instead of a status line (flow-release §4.4).
    private static readonly string[] StatusKeys = ["note-too-long", "shortlist-added", "shortlist-removed"];
    private string? StatusMessage => Status is not null && StatusKeys.Contains(Status)
        ? Status.StartsWith("shortlist-", StringComparison.Ordinal)
            ? F[$"Status_{Status}_{(athlete!.Gender == Gender.Male ? "M" : "F")}"].Value
            : L[$"Status_{Status}"].Value
        : null;

    private static bool IsGreek => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "el";

    protected override async Task OnInitializedAsync()
    {
        athlete = await Db.Athletes.AsNoTracking()
            .Include(a => a.CurrentClub)
            .Include(a => a.Seasons).ThenInclude(s => s.Club)
            .Include(a => a.Stats)
            .AsSplitQuery()
            .FirstOrDefaultAsync(a => a.Slug == Slug && a.IsDemo);

        if (athlete is null)
        {
            Navigation.NotFound();
            return;
        }

        stats = athlete.Stats.OrderByDescending(s => s.Season, StringComparer.Ordinal).ToList();
        history = athlete.Seasons.OrderByDescending(s => s.Season, StringComparer.Ordinal).ToList();
        // Proof row = strengths: the two best percentiles the Evidence panel shows (same cohort rule), only at >= 50 (lead decision);
        // none when none qualify. The bars below still show every value.
        if (stats.Count > 0 && await Cohorts.EvaluateAsync(athlete) is { } evidence)
            bestPercentiles = evidence.Metrics.Where(m => m.Percentile >= ProofMinPercentile).OrderByDescending(m => m.Percentile).Take(2).ToList();

        var user = AuthState is null ? null : (await AuthState).User;
        if (user?.Identity?.IsAuthenticated == true && int.TryParse(user.FindFirst("entity_id")?.Value, out var entityId))
        {
            if (user.IsInRole("Coach"))
            {
                coachId = entityId;
                interest = await Db.Interests.AsNoTracking().FirstOrDefaultAsync(i => i.CoachId == entityId && i.AthleteId == athlete.Id);
                shortlisted = await Db.ShortlistEntries.AnyAsync(s => s.CoachId == entityId && s.AthleteId == athlete.Id);
                if (interest is not null && Demo.Value.Enabled)
                {
                    // /demo/switch?to=athlete signs in as the athlete of the coach's LATEST interest: offer it only when that is her.
                    var latest = await Db.Interests.AsNoTracking().Where(i => i.CoachId == entityId && i.Athlete!.IsDemo)
                        .OrderByDescending(i => i.CreatedAt).ThenByDescending(i => i.Id).Select(i => i.AthleteId).FirstOrDefaultAsync();
                    showSwitch = latest == athlete.Id;
                }
            }
            else if (user.IsInRole("Athlete") && entityId == athlete.Id)
            {
                isOwnProfile = true;
                receivedCount = await Db.Interests.CountAsync(i => i.AthleteId == athlete.Id);
            }
        }
    }

    private RenderFragment ShareDetails => __builder =>
    {
        <details class="bp-rail-share">
            <summary class="bp-btn-ghost">@F["Rail_Share"]</summary>
            <div class="bp-rail-share-body">
                <label class="bp-label" for="bp-share-url">@L["Profile_Share"]</label>
                <input id="bp-share-url" class="share" type="text" readonly value="@ShareUrl" />
                <SharePanel Athlete="athlete!" />
            </div>
        </details>
    };

    private string FullName => athlete is null ? "" :
        IsGreek ? $"{athlete.FirstName} {athlete.LastName}" : $"{athlete.FirstNameLatin} {athlete.LastNameLatin}";

    private string FirstName => IsGreek ? athlete!.FirstName : athlete!.FirstNameLatin;

    private string Initials => athlete is null ? "" :
        IsGreek ? $"{athlete.FirstName[0]}{athlete.LastName[0]}" : $"{athlete.FirstNameLatin[0]}{athlete.LastNameLatin[0]}";

    private string PositionLong => L[$"Position_{athlete!.Position}"].Value;

    private int Age => Time.GetUtcNow().Year - athlete!.BirthYear;

    private string CityName => IsGreek ? athlete!.City :
        GreekNames.Cities.FirstOrDefault(c => c.Name == athlete!.City)?.NameLatin ?? athlete!.City;

    private string RegionName
    {
        get
        {
            var r = L[$"Region_{athlete!.Region}"];
            return r.ResourceNotFound ? athlete.Region : r.Value;
        }
    }

    private string ShareUrl => $"{Navigation.BaseUri}p/{Slug}";

    private string OgDescription =>
        $"{athlete!.CurrentClub?.Name ?? L["Profile_OgLookingForTeam"].Value} · {L["Brand"]}";

    private static string Num(decimal v) => v.ToString("0.0", CultureInfo.CurrentCulture);

    // Plain text, not a second SourceBadge: the table rows carry the badges (one per season).
    private static string SourceClass(StatSource s) => s switch
    {
        StatSource.CoachConfirmed => "bp-src-coach",
        StatSource.LeagueVerifiedMock => "bp-src-league",
        _ => "bp-src-self",
    };
}
