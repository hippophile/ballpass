@page "/p/{Slug}"
@using System.Globalization
@using Ballpass.Web.Components.Shared
@using Ballpass.Web.Data
@using Ballpass.Web.Demo
@using Microsoft.EntityFrameworkCore
@inject BallpassDbContext Db
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IStringLocalizer<SharedResource> L

@if (athlete is not null)
{
    <PageTitle>@FullName — @PositionLong</PageTitle>
    <HeadContent>
        <meta property="og:title" content="@($"{FullName} — {PositionLong}, {athlete.HeightCm} cm")" />
        <meta property="og:description" content="@OgDescription" />
        <meta property="og:type" content="profile" />
        <meta property="og:url" content="@ShareUrl" />
    </HeadContent>

    <section class="bp-card bp-panel profile-header">
        <div class="avatar" aria-hidden="true">@Initials</div>
        <div class="identity">
            <h1>@FullName</h1>
            <div class="badges">
                <span class="bp-badge bp-badge-demo">@L["Badge_Demo"]</span>
                @if (athlete.LookingForTeam)
                {
                    <span class="bp-badge bp-badge-looking">@L["Badge_LookingForTeam"]</span>
                }
            </div>
            <p class="meta">@PositionLong (@athlete.Position) · @athlete.HeightCm @L["Profile_Cm"] · @Age @L["Profile_Years"] · @CityName</p>
            <p class="meta"><span class="meta-label">@L["Profile_Region"]:</span> @RegionName</p>
            <p class="club"><span class="meta-label">@L["Profile_CurrentClub"]:</span>
                <strong>@(athlete.CurrentClub?.Name ?? L["Profile_NoClub"].Value)</strong></p>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <p class="bp-status" role="status">@StatusMessage</p>
    }

    @if (isOwnProfile)
    {
        <p class="bp-received"><a href="/me/inbox">@L["Profile_InterestReceived"]: @receivedCount</a></p>
    }

    @if (coachId is not null)
    {
        <section class="bp-card bp-panel bp-actions-panel">
            <h2>@L["Interest_Heading"]</h2>
            @if (interestSent)
            {
                <p class="bp-interest-sent">✓ @L["Interest_AlreadySent"]</p>
            }
            else
            {
                <form method="post" action="/p/@Slug/interest" data-action="interest" class="bp-action-form">
                    <AntiforgeryToken />
                    <label for="interest-note">@L["Interest_NoteLabel"]</label>
                    <textarea id="interest-note" name="note" maxlength="280" rows="3"></textarea>
                    <button type="submit" class="bp-btn">@L["Interest_Submit"]</button>
                </form>
            }
            <form method="post" action="/p/@Slug/shortlist" data-action="shortlist" class="bp-action-form">
                <AntiforgeryToken />
                <button type="submit" class="bp-btn">@L[shortlisted ? "Shortlist_Remove" : "Shortlist_Add"]</button>
            </form>
        </section>
    }

    <section class="bp-card bp-panel">
        <h2>@L["Profile_Stats"]</h2>
        @if (stats.Count == 0)
        {
            <p>@L["Profile_NoStats"]</p>
        }
        else
        {
            <div class="key-stats">
                <div class="key-stat"><span class="bp-stat-num">@Num(stats[0].Points)</span><span class="bp-stat-label">@L["Stat_Points"]</span></div>
                <div class="key-stat"><span class="bp-stat-num">@Num(stats[0].Rebounds)</span><span class="bp-stat-label">@L["Stat_Rebounds"]</span></div>
                <div class="key-stat"><span class="bp-stat-num">@Num(stats[0].Assists)</span><span class="bp-stat-label">@L["Stat_Assists"]</span></div>
            </div>
            <p class="key-season">@stats[0].Season · @L[$"League_{stats[0].League}"]</p>
            <div class="table-scroll">
                <table class="stats">
                    <thead>
                        <tr>
                            <th scope="col">@L["Stat_Season"]</th>
                            <th scope="col">@L["Stat_League"]</th>
                            <th scope="col">@L["Stat_Games"]</th>
                            <th scope="col">@L["Stat_Minutes"]</th>
                            <th scope="col">@L["Stat_Points"]</th>
                            <th scope="col">@L["Stat_Rebounds"]</th>
                            <th scope="col">@L["Stat_Assists"]</th>
                            <th scope="col">@L["Stat_Steals"]</th>
                            <th scope="col">@L["Stat_Blocks"]</th>
                            <th scope="col">@L["Stat_FgPct"]</th>
                            <th scope="col">@L["Stat_ThreePct"]</th>
                            <th scope="col">@L["Stat_FtPct"]</th>
                            <th scope="col">@L["Stat_Source"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in stats)
                        {
                            <tr data-season="@s.Season">
                                <th scope="row">@s.Season</th>
                                <td>@L[$"League_{s.League}"]</td>
                                <td>@s.Games</td>
                                <td>@Num(s.Minutes)</td>
                                <td>@Num(s.Points)</td>
                                <td>@Num(s.Rebounds)</td>
                                <td>@Num(s.Assists)</td>
                                <td>@Num(s.Steals)</td>
                                <td>@Num(s.Blocks)</td>
                                <td>@Num(s.FgPct)</td>
                                <td>@Num(s.ThreePct)</td>
                                <td>@Num(s.FtPct)</td>
                                <td><SourceBadge Source="s.Source" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="bp-card bp-panel">
        <h2>@L["Profile_ClubHistory"]</h2>
        <ul class="history">
            @foreach (var s in history)
            {
                <li><span class="history-season">@s.Season</span> <span>@s.Club?.Name</span></li>
            }
        </ul>
    </section>

    @if (!string.IsNullOrWhiteSpace(athlete.Bio))
    {
        <section class="bp-card bp-panel">
            <h2>@L["Profile_Bio"]</h2>
            <p>@athlete.Bio</p>
        </section>
    }

    <section class="bp-card bp-panel">
        <h2>@L["Profile_Video"]</h2>
        <p class="video-empty">@L["Profile_NoVideo"]</p>
    </section>

    <section class="bp-card bp-panel">
        <h2>@L["Profile_Share"]</h2>
        <p class="meta">@L["Profile_ShareHint"]</p>
        <input class="share" type="text" readonly value="@ShareUrl" aria-label="@L["Profile_Share"]" />
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Athlete? athlete;
    private List<StatLine> stats = [];
    private List<AthleteSeason> history = [];
    private int? coachId;
    private bool interestSent;
    private bool shortlisted;
    private bool isOwnProfile;
    private int receivedCount;

    private static readonly string[] StatusKeys = ["interest-sent", "interest-exists", "note-too-long", "shortlist-added", "shortlist-removed"];
    private string? StatusMessage => Status is not null && StatusKeys.Contains(Status) ? L[$"Status_{Status}"].Value : null;

    private static bool IsGreek => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "el";

    protected override async Task OnInitializedAsync()
    {
        athlete = await Db.Athletes.AsNoTracking()
            .Include(a => a.CurrentClub)
            .Include(a => a.Seasons).ThenInclude(s => s.Club)
            .Include(a => a.Stats)
            .AsSplitQuery()
            .FirstOrDefaultAsync(a => a.Slug == Slug && a.IsDemo);

        if (athlete is null)
        {
            Navigation.NotFound();
            return;
        }

        stats = athlete.Stats.OrderByDescending(s => s.Season, StringComparer.Ordinal).ToList();
        history = athlete.Seasons.OrderByDescending(s => s.Season, StringComparer.Ordinal).ToList();

        var user = AuthState is null ? null : (await AuthState).User;
        if (user?.Identity?.IsAuthenticated == true && int.TryParse(user.FindFirst("entity_id")?.Value, out var entityId))
        {
            if (user.IsInRole("Coach"))
            {
                coachId = entityId;
                interestSent = await Db.Interests.AnyAsync(i => i.CoachId == entityId && i.AthleteId == athlete.Id);
                shortlisted = await Db.ShortlistEntries.AnyAsync(s => s.CoachId == entityId && s.AthleteId == athlete.Id);
            }
            else if (user.IsInRole("Athlete") && entityId == athlete.Id)
            {
                isOwnProfile = true;
                receivedCount = await Db.Interests.CountAsync(i => i.AthleteId == athlete.Id);
            }
        }
    }

    private string FullName => athlete is null ? "" :
        IsGreek ? $"{athlete.FirstName} {athlete.LastName}" : $"{athlete.FirstNameLatin} {athlete.LastNameLatin}";

    private string Initials => athlete is null ? "" :
        IsGreek ? $"{athlete.FirstName[0]}{athlete.LastName[0]}" : $"{athlete.FirstNameLatin[0]}{athlete.LastNameLatin[0]}";

    private string PositionLong => L[$"Position_{athlete!.Position}"].Value;

    private int Age => Time.GetUtcNow().Year - athlete!.BirthYear;

    private string CityName => IsGreek ? athlete!.City :
        GreekNames.Cities.FirstOrDefault(c => c.Name == athlete!.City)?.NameLatin ?? athlete!.City;

    private string RegionName
    {
        get
        {
            var r = L[$"Region_{athlete!.Region}"];
            return r.ResourceNotFound ? athlete.Region : r.Value;
        }
    }

    private string ShareUrl => $"{Navigation.BaseUri}p/{Slug}";

    private string OgDescription =>
        $"{athlete!.CurrentClub?.Name ?? L["Profile_OgLookingForTeam"].Value} · {L["Profile_OgDemo"]}";

    private static string Num(decimal v) => v.ToString("0.0", CultureInfo.CurrentCulture);
}
