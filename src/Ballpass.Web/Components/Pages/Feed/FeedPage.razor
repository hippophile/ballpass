@page "/feed"
@using Ballpass.Web.Components.Feed
@using Ballpass.Web.Features.Feed
@using Ballpass.Web.Components.Engage
@using Ballpass.Web.Features.Engage
@inject IFeedService Feed
@inject ILogger<FeedPage> Logger
@inject IStringLocalizer<FeedResource> F
@inject EngageCache Engage

<PageTitle>@F["Page_Title"]</PageTitle>

<div class="bp-feed">
    <h1>@F["Page_Title"]</h1>
    <p class="bp-feed-intro">@F["Page_Intro"]</p>
    <p class="bp-feed-hint">@F["Page_DemoNote"]</p>

    @if (StatusText is not null)
    {
        <p class="bp-status" role="status" data-feed-status="@Status">@StatusText</p>
    }

    <nav class="bp-feed-tabs" aria-label="@F["Tab_Aria"]">
        <a href="/feed" aria-current="@(following ? null : "page")">@F["Tab_ForYou"]</a>
        <a href="/feed?tab=following" aria-current="@(following ? "page" : null)">@F["Tab_Following"]</a>
    </nav>
    <EngageBelowTabs Viewer="viewer" Following="following" Tag="@Tag" Before="@Before" />

    @if (viewer.SignedIn)
    {
        <Composer Viewer="viewer" ReturnUrl="@ReturnUrl" />
    }

    @if (unavailable)
    {
        <p class="bp-empty" data-feed-unavailable>@F["Unavailable"]</p>
    }
    else if (following && !viewer.SignedIn)
    {
        <div class="bp-feed-empty" data-feed-empty>
            <p>@F["Following_SignIn"]</p>
            <a class="bp-btn" href="/demo?ReturnUrl=%2Ffeed%3Ftab%3Dfollowing">@F["Following_SignInCta"]</a>
        </div>
    }
    else if (page.Items.Count == 0)
    {
        <div class="bp-feed-empty" data-feed-empty>
            <p>@F[following ? "Empty_Following" : "Empty_ForYou"]</p>
            @if (following)
            {
                <a class="bp-btn" href="/feed">@F["Empty_FollowingCta"]</a>
            }
        </div>
    }
    else
    {
        <div class="bp-feed-list">
            @foreach (var item in page.Items)
            {
                <PostCard Item="item" Viewer="viewer" ReturnUrl="@ReturnUrl" />
                <EngageInline Item="item" Items="page.Items" Viewer="viewer" />
            }
        </div>
        <p class="bp-feed-paging">
            @if (!string.IsNullOrEmpty(Before))
            {
                <a class="bp-btn bp-btn-secondary" href="@BaseUrl">@F["BackToNewest"]</a>
            }
            @if (page.NextCursor is not null)
            {
                <a class="bp-btn bp-btn-secondary" data-feed-more href="@MoreHref">@F["More"]</a>
            }
        </p>
    }
    <EngageSidebar Viewer="viewer" />
</div>

@code {
    private static readonly string[] StatusKeys = ["posted", "lft-off", "rate", "too-long", "invalid", "reported", "hidden", "blocked", "following", "unfollowed", "follow-refused"];

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "before")] public string? Before { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private FeedViewer viewer = FeedViewer.Anonymous;
    private FeedPageResult page = new([], null);
    private bool unavailable;

    private bool following => string.Equals(Tab, "following", StringComparison.OrdinalIgnoreCase);
    private string BaseUrl => (following, PostTagParser.Fold(Tag)) switch
    {
        (false, null) => "/feed",
        (true, null) => "/feed?tab=following",
        (false, _) => $"/feed?tag={Uri.EscapeDataString(Tag!.Trim().TrimStart('#'))}",
        _ => $"/feed?tab=following&tag={Uri.EscapeDataString(Tag!.Trim().TrimStart('#'))}",
    };
    private string Sep => BaseUrl.Contains('?') ? "&" : "?";
    private string ReturnUrl => string.IsNullOrEmpty(Before) ? BaseUrl : $"{BaseUrl}{Sep}before={Before}";
    private string MoreHref => $"{BaseUrl}{Sep}before={page.NextCursor}";
    private string? StatusText => Status is not null && StatusKeys.Contains(Status) ? F[$"Status_{Status}"].Value : null;

    protected override async Task OnInitializedAsync()
    {
        viewer = FeedViewer.From(AuthState is null ? null : (await AuthState).User);
        if (following && !viewer.SignedIn) return;
        try
        {
            page = await Feed.GetFeedAsync(viewer, following ? FeedTab.Following : FeedTab.ForYou, Before, Tag);
            await Engage.PreloadAsync(viewer, page.Items.Select(i => i.Post.Id));
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Feed failed to load");
            unavailable = true;
        }
    }
}
