@page "/shortlist"
@attribute [Authorize(Policy = "CoachOnly")]
@using System.Globalization
@using System.Security.Claims
@using Ballpass.Web.Data
@using Microsoft.EntityFrameworkCore
@inject BallpassDbContext Db
@inject TimeProvider Time
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Shortlist_Title"]</PageTitle>

<h1>@L["Shortlist_Title"]</h1>

@if (athletes.Count == 0)
{
    <p class="bp-empty">@L["Shortlist_Empty"]</p>
}
else
{
    <div class="bp-result-list">
        @foreach (var a in athletes)
        {
            <div class="bp-result-wrap">
                <article class="result" data-slug="@a.Slug">
                    <div class="bp-initials" aria-hidden="true">@Initials(a)</div>
                    <div class="bp-result-body">
                        <a class="bp-result-name" href="/p/@a.Slug">@FullName(a)</a>
                        <div class="bp-result-meta">@L[$"Position_{a.Position}"] · @a.HeightCm @L["Profile_Cm"] · @Age(a) @L["Profile_Years"]</div>
                        <div class="bp-result-meta">@(a.CurrentClub?.Name ?? L["Profile_NoClub"].Value)</div>
                        @if (a.LookingForTeam)
                        {
                            <span class="bp-looking">@L["Badge_LookingForTeam"]</span>
                        }
                    </div>
                    <form method="post" action="/p/@a.Slug/shortlist" class="bp-result-actions">
                        <AntiforgeryToken />
                        <button type="submit" class="bp-btn">@L["Shortlist_Remove"]</button>
                    </form>
                </article>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Athlete> athletes = [];

    private static bool IsGreek => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "el";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (!int.TryParse(user.FindFirst("entity_id")?.Value, out var coachId)) return;

        athletes = await Db.ShortlistEntries.AsNoTracking()
            .Where(s => s.CoachId == coachId)
            .OrderByDescending(s => s.CreatedAt).ThenByDescending(s => s.Id)
            .Select(s => s.Athlete!)
            .ToListAsync();
        var clubIds = athletes.Where(a => a.CurrentClubId != null).Select(a => a.CurrentClubId!.Value).Distinct().ToList();
        var clubs = await Db.Clubs.AsNoTracking().Where(c => clubIds.Contains(c.Id)).ToDictionaryAsync(c => c.Id);
        foreach (var a in athletes.Where(a => a.CurrentClubId != null)) a.CurrentClub = clubs[a.CurrentClubId!.Value];
    }

    private string FullName(Athlete a) => IsGreek ? $"{a.FirstName} {a.LastName}" : $"{a.FirstNameLatin} {a.LastNameLatin}";
    private string Initials(Athlete a) => IsGreek ? $"{a.FirstName[0]}{a.LastName[0]}" : $"{a.FirstNameLatin[0]}{a.LastNameLatin[0]}";
    private int Age(Athlete a) => Time.GetUtcNow().Year - a.BirthYear;
}
