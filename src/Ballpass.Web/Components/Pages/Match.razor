@page "/match"
@attribute [Authorize(Policy = "CoachOnly")]
@using System.Globalization
@using System.Security.Claims
@using Ballpass.Web.Data
@using Ballpass.Web.Features.Evidence
@using Ballpass.Web.Features.Find
@using Ballpass.Web.Features.Find.Ai
@using Ballpass.Web.Features.Find.Fit
@using Ballpass.Web.Features.Loop
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject BallpassDbContext Db
@inject NavigationManager Nav
@inject IOptions<DemoOptions> Demo
@inject TimeProvider Time
@inject FitScorer Scorer
@inject IOptions<FitOptions> FitConfig
@inject IOptions<EvidenceOptions> EvidenceConfig
@inject ICohortService Cohorts
@inject IStringLocalizer<FindResource> F
@inject IStringLocalizer<SharedResource> S

<PageTitle>@F["Match_Title"]</PageTitle>

@* flow-release §4.5: glow, need chip bar, AI box, filters | results (top match + 2-column cards). One orange CTA: the top card's. *@
<div class="bp-match">
<header class="bp-match-head">
    <h1>@F["Match_Title"]</h1>
    @if (NeedChips.Count > 0)
    {
        <div class="bp-match-need" role="group" aria-label="@F["Match_NeedAria"]">
            @foreach (var chip in NeedChips)
            {
                <span class="bp-match-need-chip">@chip</span>
            }
            <a class="bp-match-need-edit" href="#bp-need">@F["Match_NeedChange"]</a>
        </div>
    }
</header>

<AiSearchBox Target="match" />

<div class="bp-find-layout">
    @* Desktop: the details is always shown open by CSS (::details-content); below 900 px it is the "Φίλτρα (n)" sheet. *@
    <details class="bp-find-filters" id="bp-need">
        <summary class="bp-btn-outline">@F["Match_Filters", FilterCount]</summary>
    <form method="get" action="/match" class="bp-find-form">
        <h2>@F["Need_Heading"]</h2>
        <p class="bp-find-hint">@F["Need_HardHint"]</p>
        <fieldset class="bp-field">
            <legend>@F["Need_Gender"]</legend>
            <label><input type="radio" name="gender" value="Female" checked="@(!IsMale)"> @S["Gender_Female"]</label>
            <label><input type="radio" name="gender" value="Male" checked="@IsMale"> @S["Gender_Male"]</label>
        </fieldset>
        <fieldset class="bp-field">
            <legend>@F["Need_Position"]</legend>
            @foreach (var p in SearchFilterValidator.Positions)
            {
                <label><input type="checkbox" name="position" value="@p" checked="@(SelectedPositions.Contains(p))"> @S[$"Position_{p}"] (@p)</label>
            }
        </fieldset>
        <div class="bp-field">
            <label for="minHeight">@F["Need_Height"]</label>
            <div class="bp-range">
                <input id="minHeight" type="number" name="minHeight" min="100" max="260" value="@MinHeight">
                <span aria-hidden="true">–</span>
                <label class="visually-hidden" for="maxHeight">@F["Need_HeightTo"]</label>
                <input id="maxHeight" type="number" name="maxHeight" min="100" max="260" value="@MaxHeight">
            </div>
        </div>
        <div class="bp-field">
            <label for="minAge">@F["Need_Age"]</label>
            <div class="bp-range">
                <input id="minAge" type="number" name="minAge" min="18" max="80" value="@MinAge">
                <span aria-hidden="true">–</span>
                <label class="visually-hidden" for="maxAge">@F["Need_AgeTo"]</label>
                <input id="maxAge" type="number" name="maxAge" min="18" max="80" value="@MaxAge">
            </div>
        </div>
        <div class="bp-field">
            <label for="region">@F["Need_Region"]</label>
            <select id="region" name="region">
                <option value="">@F["Need_Any"]</option>
                @foreach (var r in SearchFilterValidator.Regions)
                {
                    <option value="@r" selected="@(Region == r)">@RegionName(r)</option>
                }
            </select>
        </div>
        <div class="bp-field">
            <label for="league">@F["Need_League"]</label>
            <select id="league" name="league">
                <option value="">@F["Need_Any"]</option>
                @foreach (var l in SearchFilterValidator.Leagues)
                {
                    <option value="@l" selected="@(League == l)">@S[$"League_{l}"]</option>
                }
            </select>
        </div>
        <fieldset class="bp-field">
            <legend>@F["Need_Priority"]</legend>
            <label><input type="radio" name="priority" value="" checked="@(need.Priority == FitPriority.None)"> @F["Priority_None"]</label>
            @foreach (var p in PriorityOptions)
            {
                <label><input type="radio" name="priority" value="@p.ToString().ToLowerInvariant()" checked="@(need.Priority == p)"> @F[$"Priority_{p}"]</label>
            }
        </fieldset>
        <div class="bp-field">
            <label><input type="checkbox" name="confirmed" value="true" checked="@need.ConfirmedOnly"> @F["Need_Confirmed"]</label>
        </div>
        <div class="bp-actions">
            <button type="submit" class="bp-btn-outline">@F["Need_Submit"]</button>
            <a href="/match" class="bp-clear">@F["Need_Clear"]</a>
        </div>
    </form>
    </details>

    <section class="bp-find-results" aria-live="polite" aria-labelledby="bp-find-results-h">
        <h2 id="bp-find-results-h" class="visually-hidden">@F["Results_Heading"]</h2>
        <div class="bp-find-resbar">
            <p class="bp-find-count">
                <strong data-total="@ranking.Results.Count">@F[ranking.Results.Count == 1 ? "Results_Count_One" : "Results_Count", ranking.Results.Count]</strong>
                <span class="bp-find-hidden" data-hidden="@ranking.Hidden">@F[ranking.Hidden == 1 ? "Results_Hidden_One" : "Results_Hidden", ranking.Hidden]</span>
            </p>
            @if (trust is not null)
            {
                <div class="bp-find-trust" data-self="@trust.SelfReported" data-coach="@trust.CoachConfirmed" data-league="@trust.LeagueVerified"
                     role="img" aria-label="@F["Trust_Aria", trust.SelfReported, trust.CoachConfirmed, trust.LeagueVerified]" title="@F["Trust_Heading"] · @F["Trust_Count", withStats]">
                    <div class="bp-find-trust-bar" aria-hidden="true">
                        <span class="bp-find-seg bp-find-seg-self" style="width:@(trust.SelfReported)%"></span>
                        <span class="bp-find-seg bp-find-seg-coach" style="width:@(trust.CoachConfirmed)%"></span>
                        <span class="bp-find-seg bp-find-seg-league" style="width:@(trust.LeagueVerified)%"></span>
                    </div>
                    <ul class="bp-find-trust-legend" aria-hidden="true">
                        <li class="bp-src-self"><span class="bp-find-dot bp-find-seg-self"></span>@S["Source_SelfReported"] <b>@trust.SelfReported%</b></li>
                        <li class="bp-src-coach"><span class="bp-find-dot bp-find-seg-coach"></span>@S["Source_CoachConfirmed"] <b>@trust.CoachConfirmed%</b></li>
                        <li class="bp-src-league"><span class="bp-find-dot bp-find-seg-league"></span>@S["Source_LeagueVerifiedMock"] <b>@trust.LeagueVerified%</b></li>
                    </ul>
                </div>
            }
            <details class="bp-find-weights">
                <summary>@F["Weights_Heading"]</summary>
                <div class="bp-find-weights-body">
                    <p>@F["Weights_Intro", FitConfig.Value.MinGames, EvidenceConfig.Value.MinMinutesPerGame.ToString("0.#", CultureInfo.CurrentCulture), EvidenceConfig.Value.MinPeers]</p>
                    <ul>
                        <li>@F["Weight_Height"]: @Pct(FitConfig.Value.Weights.Height)</li>
                        <li>@F["Weight_Stat"]: @Pct(FitConfig.Value.Weights.Stat)</li>
                        <li>@F["Weight_Region"]: @Pct(FitConfig.Value.Weights.Region)</li>
                        <li>@F["Weight_Age"]: @Pct(FitConfig.Value.Weights.Age)</li>
                        <li>@F["Weight_League"]: @Pct(FitConfig.Value.Weights.League)</li>
                    </ul>
                </div>
            </details>
        </div>
        <p class="bp-find-disclaimer">@F["Results_Label"]</p>

        @if (!ranked && ranking.Results.Count > 0)
        {
            @* No scoring criterion: no rings at all (never "–"), one prompt card instead (SPEC §4.5). *@
            <div class="bp-card bp-panel bp-match-prompt" data-match-prompt>
                <p class="bp-match-prompt-title">@F["Match_PromptTitle"]</p>
                <p class="bp-find-note">@(need.Positions.Count > 0 ? F["Results_Unranked"] : F["Match_PromptBody"])</p>
                <div class="bp-match-prompt-act">
                    @if (FeaturedChips.Count > 0)
                    {
                        <a class="bp-btn-primary" href="/match?need=featured">@F["Match_PromptTry", string.Join(" · ", FeaturedChips)]</a>
                    }
                    <a class="bp-btn-ghost" href="#bp-need">@F["Match_PromptFill"]</a>
                </div>
            </div>
        }

        @if (ranking.Results.Count == 0)
        {
            <p class="bp-find-note">@F["Results_None"]</p>
        }
        else
        {
            @if (top is not null)
            {
                <AthleteMatchCard Athlete="athletes[top.Candidate.Slug]" Variant="top" Fit="top" Need="need" Age="top.Candidate.Age" Sent="sent.Contains(top.Candidate.Slug)" />
            }
            <div class="bp-find-grid">
                @foreach (var r in shown)
                {
                    <AthleteMatchCard Athlete="athletes[r.Candidate.Slug]" Variant="match" Fit="r" Need="need" Age="r.Candidate.Age" Sent="sent.Contains(r.Candidate.Slug)" />
                }
            </div>
            @if (remaining > 0)
            {
                <p class="bp-find-more">
                    <span class="bp-find-note">@F["Results_Showing", shown.Count + (top is null ? 0 : 1)]</span>
                    <a class="bp-btn-outline" href="@MoreHref">@F["Match_More"]</a>
                </p>
            }
        }
    </section>
</div>
</div>

@code {
    private const int ShowRest = 12;
    private const int MaxRest = 48;
    private static readonly FitPriority[] PriorityOptions = [FitPriority.Rebounding, FitPriority.Scoring, FitPriority.Playmaking];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery(Name = "gender")] public string? Gender { get; set; }
    [SupplyParameterFromQuery(Name = "position")] public string[]? Position { get; set; }
    // Raw strings: the typed binder throws on "abc" for an int or "maybe" for a bool. Read leniently (invalid = absent).
    [SupplyParameterFromQuery(Name = "minHeight")] public string? MinHeightRaw { get; set; }
    [SupplyParameterFromQuery(Name = "maxHeight")] public string? MaxHeightRaw { get; set; }
    [SupplyParameterFromQuery(Name = "minAge")] public string? MinAgeRaw { get; set; }
    [SupplyParameterFromQuery(Name = "maxAge")] public string? MaxAgeRaw { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string? Region { get; set; }
    [SupplyParameterFromQuery(Name = "league")] public string? League { get; set; }
    [SupplyParameterFromQuery(Name = "priority")] public string? Priority { get; set; }
    [SupplyParameterFromQuery(Name = "confirmed")] public string? ConfirmedRaw { get; set; }
    /// <summary>"featured" = the need in Demo:Featured:NeedQuery (the 60-second demo path).</summary>
    [SupplyParameterFromQuery(Name = "need")] public string? NeedRaw { get; set; }
    /// <summary>How many cards after the top match ("Περισσότερα" asks for 12 more).</summary>
    [SupplyParameterFromQuery(Name = "take")] public string? TakeRaw { get; set; }

    private int? MinHeight => LenientQuery.Int(MinHeightRaw, 0, 400);
    private int? MaxHeight => LenientQuery.Int(MaxHeightRaw, 0, 400);
    private int? MinAge => LenientQuery.Int(MinAgeRaw, 0, 150);
    private int? MaxAge => LenientQuery.Int(MaxAgeRaw, 0, 150);
    private bool Confirmed => LenientQuery.Flag(ConfirmedRaw);
    private int Take => Math.Clamp(LenientQuery.Int(TakeRaw, 1, 1000) ?? ShowRest, ShowRest, MaxRest);

    private FitNeed need = new();
    private FitRanking ranking = new([], 0);
    private FitResult? top;
    private List<FitResult> shown = [];
    private int remaining;
    private Dictionary<string, Athlete> athletes = [];
    private HashSet<string> sent = [];
    private TrustShares? trust;
    private int withStats;
    private bool ranked;
    private List<string> NeedChips = [];
    private List<string> FeaturedChips = [];

    private bool IsMale => Gender == "Male";
    private string[] SelectedPositions => (Position ?? []).Where(p => SearchFilterValidator.Positions.Contains(p)).Distinct().ToArray();

    protected override async Task OnInitializedAsync()
    {
        var year = Time.GetUtcNow().Year;
        var featuredQuery = Demo.Value.Featured.NeedQuery;
        if (NeedRaw == "featured" && !string.IsNullOrWhiteSpace(featuredQuery)) ApplyQuery(featuredQuery);
        var gender = IsMale ? Data.Gender.Male : Data.Gender.Female;

        need = BuildNeed();

        // The whole same-gender demo cohort is loaded (a few hundred rows): percentiles are computed against it, hard filters hide inside the scorer.
        var rows = await Db.Athletes.AsNoTracking().Where(a => a.IsDemo && a.Gender == gender)
            .Include(a => a.CurrentClub).Include(a => a.Stats).ToListAsync();
        athletes = rows.ToDictionary(a => a.Slug);
        // The stat criterion uses the profile's own percentile (same cohort rule as Evidence); no percentile = criterion missing.
        var metric = StatMetric(need.Priority);
        var percentiles = metric is { } m ? await Cohorts.PercentilesAsync(gender, m) : new Dictionary<int, CohortPercentile>();
        var cohort = rows.Select(a =>
        {
            var line = a.Stats.OrderByDescending(s => s.Season, StringComparer.Ordinal).FirstOrDefault();
            var stat = line is null ? null : new FitStat(line.Season, line.Games, line.Points, line.Rebounds, line.Assists, line.Source);
            var rank = percentiles.TryGetValue(a.Id, out var p) ? new FitStatRank(p.Value, p.Percentile) : null;
            return new FitCandidate(a.Slug, a.Position, a.HeightCm, year - a.BirthYear, a.Region, a.CurrentClub?.League, stat, rank);
        }).ToList();

        ranking = Scorer.Rank(need, cohort);
        ranked = ranking.Results.Any(r => r.FitPercent is not null);
        // The top match card only exists for a scored list; an unranked list has no "best" (and no rings).
        top = ranked ? ranking.Results[0] : null;
        var rest = ranking.Results.Skip(top is null ? 0 : 1).ToList();
        shown = rest.Take(Take).ToList();
        remaining = rest.Count - shown.Count;

        var sources = ranking.Results.Select(r => r.Candidate.Stat?.Source).ToList();
        trust = TrustBar.Compute(sources);
        withStats = sources.Count(s => s is not null);

        NeedChips = Chips(need);
        if (!string.IsNullOrWhiteSpace(featuredQuery))
        {
            var saved = (Gender, Position, MinHeightRaw, MaxHeightRaw, MinAgeRaw, MaxAgeRaw, Region, League, Priority, ConfirmedRaw);
            ApplyQuery(featuredQuery);
            FeaturedChips = Chips(BuildNeed());
            (Gender, Position, MinHeightRaw, MaxHeightRaw, MinAgeRaw, MaxAgeRaw, Region, League, Priority, ConfirmedRaw) = saved;
        }

        var user = AuthState is null ? null : (await AuthState).User;
        if (int.TryParse(user?.FindFirstValue("entity_id"), out var coachId))
        {
            var slugs = shown.Select(r => r.Candidate.Slug).Concat(top is null ? [] : [top.Candidate.Slug]).ToList();
            sent = (await Db.Interests.Where(i => i.CoachId == coachId && slugs.Contains(i.Athlete!.Slug))
                .Select(i => i.Athlete!.Slug).ToListAsync()).ToHashSet();
        }
    }

    private FitNeed BuildNeed()
    {
        var league = Enum.TryParse<Data.League>(League, out var l) && SearchFilterValidator.Leagues.Contains(League!) ? l : (Data.League?)null;
        return new FitNeed
        {
            Positions = SelectedPositions.Select(p => Enum.Parse<Data.Position>(p)).ToArray(),
            MinHeight = MinHeight, MaxHeight = MaxHeight,
            MinAge = MinAge is { } a1 ? Math.Max(18, a1) : null,
            MaxAge = MaxAge is { } a2 ? Math.Max(18, a2) : null,
            Region = SearchFilterValidator.Regions.Contains(Region ?? "") ? Region : null,
            League = league,
            Priority = Enum.TryParse<FitPriority>(Priority, ignoreCase: true, out var pr) && PriorityOptions.Contains(pr) ? pr : FitPriority.None,
            ConfirmedOnly = Confirmed,
        };
    }

    /// <summary>Reads a Match query string (Demo:Featured:NeedQuery) into the same raw parameters the URL would set.</summary>
    private void ApplyQuery(string query)
    {
        var q = QueryHelpers.ParseQuery(query.StartsWith('?') ? query : "?" + query);
        string? One(string key) => q.TryGetValue(key, out var v) ? v.ToString() : null;
        Gender = One("gender");
        Position = q.TryGetValue("position", out var ps) ? ps.Where(p => p is not null).Select(p => p!).ToArray() : null;
        MinHeightRaw = One("minHeight"); MaxHeightRaw = One("maxHeight");
        MinAgeRaw = One("minAge"); MaxAgeRaw = One("maxAge");
        Region = One("region"); League = One("league");
        Priority = One("priority"); ConfirmedRaw = One("confirmed");
    }

    /// <summary>Need summary for the header chip bar: "Σούτινγκ γκαρντ · 174–177 εκ. · 22–28 ετών · Κρήτη".</summary>
    private List<string> Chips(FitNeed n)
    {
        var chips = new List<string>();
        if (n.Positions.Count > 0) chips.Add(string.Join(", ", n.Positions.Select(p => S[$"Position_{p}"].Value)));
        if (n.WantsHeight) chips.Add($"{Target(n.MinHeight, n.MaxHeight)} {S["Profile_Cm"]}");
        if (n is { MinAge: { } lo, MaxAge: { } hi }) chips.Add(F["Match_NeedAges", lo, hi]);
        else if (n.MinAge is { } lo2) chips.Add(F["Match_NeedAgeMin", lo2]);
        else if (n.MaxAge is { } hi2) chips.Add(F["Match_NeedAgeMax", hi2]);
        if (n.Region is { } r) chips.Add(RegionName(r));
        if (n.League is { } l) chips.Add(S[$"League_{l}"]);
        if (n.Priority != FitPriority.None) chips.Add(F[$"Priority_{n.Priority}"]);
        if (n.ConfirmedOnly) chips.Add(F["Match_NeedConfirmed"]);
        return chips;
    }

    private int FilterCount => NeedChips.Count;

    /// <summary>Same URL with 12 more cards (GET, no JavaScript).</summary>
    private string MoreHref
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            var q = QueryHelpers.ParseQuery(uri.Query).Where(kv => kv.Key != "take")
                .SelectMany(kv => kv.Value.Select(v => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? "")}"));
            return "/match?" + string.Join("&", q.Append($"take={Math.Min(Take + ShowRest, MaxRest)}"));
        }
    }

    private static EvidenceMetric? StatMetric(FitPriority priority) => priority switch
    {
        FitPriority.Rebounding => EvidenceMetric.Rebounds,
        FitPriority.Scoring => EvidenceMetric.Points,
        FitPriority.Playmaking => EvidenceMetric.Assists,
        _ => null,
    };

    private static string Pct(double w) => $"{Math.Round(w * 100):0}%";

    private string RegionName(string r)
    {
        var s = S[$"Region_{r}"];
        return s.ResourceNotFound ? r : s.Value;
    }

    private static string Target(int? min, int? max) => (min, max) switch
    {
        ({ } lo, { } hi) => $"{lo}–{hi}",
        ({ } lo, null) => $"≥{lo}",
        (null, { } hi) => $"≤{hi}",
        _ => "",
    };
}
