@page "/demo"
@using System.Globalization
@using Ballpass.Web.Components.Flow
@using Ballpass.Web.Data
@using Ballpass.Web.Demo
@using Ballpass.Web.Features.Flow
@using Ballpass.Web.Features.Loop
@using Ballpass.Web.Features.Media
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject BallpassDbContext Db
@inject IOptions<DemoOptions> Demo
@inject IStringLocalizer<SharedResource> L
@inject IStringLocalizer<FlowResource> T

<PageTitle>@L["Demo_Title"]</PageTitle>

@* flow-release §4.2: the two featured personas as photo cards first (O7, from Demo:Featured), then two compact lists side by side,
   8 rows each before "Όλοι (n)". Every card and row is a plain persona form (POST /demo/login). *@
<div class="bp-demo">
    <h1>@L["Demo_Title"]</h1>
    <p class="bp-demo-intro">@L["Demo_Intro"]</p>

    @if (featured.Coach is not null || featured.Athlete is not null)
    {
        <section class="bp-persona-hero">
            @if (featured.Coach is { } fc)
            {
                var name = CoachName(fc);
                <PersonaDoor Image="FlowMedia.FeaturedCoach(IsFemale(fc))" PersonaType="coach" PersonaId="fc.Id" ReturnUrl="@(ReturnUrl ?? FeaturedPersonas.CoachReturnUrl)" Priority="true"
                             Class="bp-persona-hero-card" Title="@T[IsFemale(fc) ? "Demo_AsCoachF" : "Demo_AsCoach"]"
                             Text="@($"{name} · {fc.Club?.Name} · {L[$"League_{fc.Club?.League}"]}")" Cta="@T["Door_CoachCta"]"
                             data-persona="coach" data-featured="" data-name="@name" />
            }
            @if (featured.Athlete is { } fa)
            {
                var name = AthleteName(fa);
                <PersonaDoor Image="StockMedia.PersonaAthlete" PersonaType="athlete" PersonaId="fa.Id" ReturnUrl="@(ReturnUrl ?? FeaturedPersonas.AthleteReturnUrl)" Priority="true"
                             Class="bp-persona-hero-card" Title="@T[fa.Gender == Gender.Female ? "Demo_AsAthleteF" : "Demo_AsAthlete"]"
                             Text="@($"{name} · {fa.Position} · {fa.CurrentClub?.Name ?? L["Profile_NoClub"].Value}")" Cta="@T["Door_AthleteCta"]"
                             data-persona="athlete" data-featured="" data-name="@name" data-slug="@fa.Slug" />
            }
        </section>
    }

    <div class="bp-persona-lists">
        <section class="bp-persona-list" data-list="coaches" aria-labelledby="bp-list-coaches">
            <h2 id="bp-list-coaches" class="bp-persona-list-title">@L["Demo_Coaches"]</h2>
            @foreach (var c in coaches.Take(Visible))
            {
                @CoachRow(c)
            }
            @if (coaches.Count > Visible)
            {
                <details class="bp-persona-more">
                    <summary>@T["Demo_All", coaches.Count]</summary>
                    @foreach (var c in coaches.Skip(Visible))
                    {
                        @CoachRow(c)
                    }
                </details>
            }
        </section>

        <section class="bp-persona-list" data-list="athletes" aria-labelledby="bp-list-athletes">
            <h2 id="bp-list-athletes" class="bp-persona-list-title">@L["Demo_Athletes"]</h2>
            @foreach (var a in athletes.Take(Visible))
            {
                @AthleteRow(a)
            }
            @if (athletes.Count > Visible)
            {
                <details class="bp-persona-more">
                    <summary>@T["Demo_All", athletes.Count]</summary>
                    @foreach (var a in athletes.Skip(Visible))
                    {
                        @AthleteRow(a)
                    }
                </details>
            }
        </section>
    </div>

    <ResetLink />
</div>

@code {
    private const int Visible = 8;

    [SupplyParameterFromQuery(Name = "ReturnUrl")] public string? ReturnUrl { get; set; }

    private FeaturedPersonas featured = new(null, null);
    private List<Coach> coaches = [];
    private List<Athlete> athletes = [];

    private static bool IsGreek => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "el";

    protected override async Task OnInitializedAsync()
    {
        featured = await FeaturedPersonas.LoadAsync(Db, Demo.Value.Featured);
        var featuredCoachId = featured.Coach?.Id ?? 0;
        var featuredAthleteId = featured.Athlete?.Id ?? 0;

        coaches = await Db.Coaches.AsNoTracking().Include(c => c.Club)
            .Where(c => c.IsDemo && c.Role == CoachRole.Head && c.Id != featuredCoachId)
            .OrderBy(c => c.Club!.Name).ThenBy(c => c.Id).ToListAsync();

        // Showcase mix: athletes with a club and the most seasons first, then some looking for a team.
        athletes = [
            .. (await Showcase(Gender.Female, withClub: 5, looking: 3)).Where(a => a.Id != featuredAthleteId),
            .. await Showcase(Gender.Male, withClub: 3, looking: 1),
        ];
    }

    // Seeded interest counts per athlete, computed once from the deterministic generator. Live interests sent
    // during a demo never reshuffle the persona list (audit M1).
    private static readonly Dictionary<string, int> SeededInterests =
        DemoDataGenerator.Generate(DemoDataSeeder.Seed).Interests
            .GroupBy(i => i.Athlete!.Slug).ToDictionary(g => g.Key, g => g.Count());

    private async Task<List<Athlete>> Showcase(Gender gender, int withClub, int looking)
    {
        // Athletes with seeded interest waiting first (inbox not empty in the demo), then most seasons, then id.
        var candidates = await Db.Athletes.AsNoTracking().Include(a => a.CurrentClub).Include(a => a.Stats)
            .Where(a => a.IsDemo && a.Gender == gender).ToListAsync();
        IEnumerable<Athlete> Rank(IEnumerable<Athlete> q) => q
            .OrderByDescending(a => SeededInterests.GetValueOrDefault(a.Slug))
            .ThenByDescending(a => a.Stats.Count).ThenBy(a => a.Id);
        return [
            .. Rank(candidates.Where(a => a.CurrentClubId != null)).Take(withClub),
            .. Rank(candidates.Where(a => a.CurrentClubId == null)).Take(looking),
        ];
    }

    private static bool IsFemale(Coach c) => GreekNames.IsFemaleFirstName(c.FirstName);

    private static string CoachName(Coach c) => IsGreek ? $"{c.FirstName} {c.LastName}" : $"{c.FirstNameLatin} {c.LastNameLatin}";

    private static string AthleteName(Athlete a) => IsGreek ? $"{a.FirstName} {a.LastName}" : $"{a.FirstNameLatin} {a.LastNameLatin}";

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper(CultureInfo.CurrentCulture);

    private RenderFragment CoachRow(Coach c)
    {
        var name = CoachName(c);
        return @<form method="post" action="/demo/login" data-persona="coach" data-name="@name" class="bp-persona-row">
            <input type="hidden" name="personaType" value="coach">
            <input type="hidden" name="personaId" value="@c.Id">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "")">
            <AntiforgeryToken />
            <button type="submit" class="bp-persona-btn">
                <JerseyAvatar Id="c.Id" Initials="@Initials(name)" Club="@c.Club?.Name" Coach="true" Size="40" />
                <span class="bp-persona-text">
                    <span class="bp-persona-name">@name</span>
                    <span class="bp-persona-info">@L[IsFemale(c) ? "Role_Coach_F" : "Role_Coach"] · @c.Club?.Name · @L[$"League_{c.Club!.League}"]</span>
                </span>
                <span class="bp-persona-chevron" aria-hidden="true">›</span>
            </button>
        </form>;
    }

    private RenderFragment AthleteRow(Athlete a)
    {
        var name = AthleteName(a);
        return @<form method="post" action="/demo/login" data-persona="athlete" data-name="@name" data-slug="@a.Slug" class="bp-persona-row">
            <input type="hidden" name="personaType" value="athlete">
            <input type="hidden" name="personaId" value="@a.Id">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "")">
            <AntiforgeryToken />
            <button type="submit" class="bp-persona-btn">
                <JerseyAvatar Id="a.Id" Initials="@Initials(name)" Club="@a.CurrentClub?.Name" Size="40" />
                <span class="bp-persona-text">
                    <span class="bp-persona-name">@name @if (a.LookingForTeam) { <span class="bp-chip-athlete">@T["Chip_Looking"]</span> }</span>
                    <span class="bp-persona-info">@L[$"Position_{a.Position}"] · @(a.CurrentClub?.Name ?? L["Profile_NoClub"].Value)</span>
                </span>
                <span class="bp-persona-chevron" aria-hidden="true">›</span>
            </button>
        </form>;
    }
}
