@using Ballpass.Web.Data
@inject IStringLocalizer<SharedResource> L

@* Source badge: icon + text (colour is never the only cue). Markup contract: data-source + <svg> + .bp-badge-text. *@
<span class="bp-badge @CssClass" data-source="@Source">
    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        @switch (Source)
        {
            case StatSource.CoachConfirmed:
                <circle cx="8" cy="8" r="6.5" /><path d="M5 8.3l2.2 2.2L11 6" />
                break;
            case StatSource.LeagueVerifiedMock:
                <path d="M8 1.5l5.5 2v4c0 3.3-2.3 5.7-5.5 7-3.2-1.3-5.5-3.7-5.5-7v-4z" /><path d="M5.6 8.2l1.8 1.8 3-3.4" />
                break;
            default:
                <circle cx="8" cy="8" r="5.5" />
                break;
        }
    </svg>
    <span class="bp-badge-text">@L[$"Source_{Source}"]</span>
</span>

@code {
    [Parameter, EditorRequired] public StatSource Source { get; set; }

    private string CssClass => Source switch
    {
        StatSource.CoachConfirmed => "bp-src-coach",
        StatSource.LeagueVerifiedMock => "bp-src-league",
        _ => "bp-src-self",
    };
}
