@inherits LayoutComponentBase
@using System.Globalization
@using Ballpass.Web.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject IServiceScopeFactory ScopeFactory
@inject IStringLocalizer<SharedResource> L

<div class="demo-banner" role="status">
    <span lang="el">Περιβάλλον επίδειξης — όλοι οι αθλητές, προπονητές και σύλλογοι είναι φανταστικοί.</span>
    <span lang="en">Demo environment — all athletes, coaches and clubs are fictional.</span>
</div>

<header class="topbar">
    <a class="brand" href="/">@L["Brand"]</a>
    <nav class="bp-userbar" aria-label="@L["Nav_Main"]">
        @NavItems
    </nav>
    <nav class="lang-toggle" aria-label="@L["Nav_Language"]">
        <a href="@LangHref("el")" hreflang="el" class="@(Lang == "el" ? "active" : null)" aria-current="@(Lang == "el" ? "true" : null)">EL</a>
        <span aria-hidden="true">|</span>
        <a href="@LangHref("en")" hreflang="en" class="@(Lang == "en" ? "active" : null)" aria-current="@(Lang == "en" ? "true" : null)">EN</a>
    </nav>
    <details class="bp-menu">
        <summary>@L["Nav_Menu"]</summary>
        <nav class="bp-menu-links" aria-label="@L["Nav_Main"]">
            @NavItems
        </nav>
    </details>
</header>

<main>
    <article class="content">
        @Body
    </article>
</main>

@code {
    // Rendered twice: inline bar on desktop, inside <details> on phones (CSS shows one; no JavaScript).
    private RenderFragment NavItems => @<text>
        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole("Coach"))
                {
                    <a href="/search">@L["Nav_Search"]</a>
                    <a href="/shortlist">@L["Nav_Shortlist"]</a>
                }
                else if (context.User.IsInRole("Athlete"))
                {
                    <a href="/me/inbox">@L["Nav_Inbox"] (@inboxCount)</a>
                }
                <span class="bp-whoami">@PersonaName(context.User) <small>(@L[(context.User.IsInRole("Coach") ? "Role_Coach" : "Role_Athlete") + (context.User.FindFirst("gender")?.Value == "F" ? "_F" : "")])</small></span>
                <form method="post" action="/demo/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="bp-logout">@L["Nav_Logout"]</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/demo">@L["Nav_DemoLogin"]</a>
            </NotAuthorized>
        </AuthorizeView>
    </text>;

    private static string Lang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private static string PersonaName(System.Security.Claims.ClaimsPrincipal user) =>
        (Lang == "el" ? user.Identity?.Name : user.FindFirst("name_latin")?.Value ?? user.Identity?.Name) ?? "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int inboxCount;

    // Own scope + DbContext: the layout initialises concurrently with the page, which holds the request-scoped context.
    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        if (user?.IsInRole("Athlete") != true || !int.TryParse(user.FindFirst("entity_id")?.Value, out var id)) return;

        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<BallpassDbContext>();
        inboxCount = await db.Interests.CountAsync(i => i.AthleteId == id);
    }

    private string LangHref(string culture) =>
        $"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";
}
