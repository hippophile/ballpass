@using Ballpass.Web.Features.Feed
@using Ballpass.Web.Features.Media
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<FeedPreview> Logger
@inject IStringLocalizer<FeedResource> F

@* Home strip: the newest public posts, read-only. If the feed fails the strip is simply not rendered. *@
@if (items.Count > 0)
{
    <section class="bp-feed-preview" aria-labelledby="bp-feed-preview-title">
        <div class="bp-feed-preview-head">
            <h2 id="bp-feed-preview-title">@F["Preview_Title"]</h2>
            <a href="/feed">@F["Preview_More"]</a>
        </div>
        <div class="bp-feed-preview-list">
            @foreach (var item in items)
            {
                @* flow-release §4.1: a 16:10 photo header from the feed pool (by post id); the card's own media stay in /feed. *@
                <div class="bp-feed-preview-card">
                    <StockPhoto Image="StockMedia.Feed(item.Post.Id)" Class="bp-feed-preview-photo" />
                    <PostCard Item="item" ReadOnly="true" HideMedia="true" />
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public int Count { get; set; } = 3;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<FeedItem> items = [];

    // Own scope + DbContext: this component initialises while the host page still holds the request-scoped context.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var viewer = FeedViewer.From(AuthState is null ? null : (await AuthState).User);   // same hide / block filters as /feed
            using var scope = ScopeFactory.CreateScope();
            items = await scope.ServiceProvider.GetRequiredService<IFeedService>().GetPreviewAsync(viewer, Count);
        }
        catch (Exception e)
        {
            Logger.LogWarning(e, "Feed preview failed; rendering nothing");
            items = [];
        }
    }
}
